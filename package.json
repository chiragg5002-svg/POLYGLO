{
  "name": "maestro",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit --testPathIgnorePatterns /tests/live/ /tests/integration/ /tests/conformance/ /node_modules/ /tests/helpers/",
    "test:integration": "jest --runInBand tests/integration",
    "test:dbaas": "jest --runInBand tests/dbaas",
    "test:live": "jest --runInBand --forceExit tests/live tests/conformance tests/integration",
    "test:sdk": "jest --runInBand tests/sdk",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "bench:routing": "node benchmarks/routing/run.js",
    "bench:load": "node scripts/load-test.js",
    "test:resilience": "node scripts/resilience-test.js",
    "test:backup": "node scripts/backup-restore-test.js",
    "billing:daily": "node scripts/daily-billing.js",
    "scan:secrets": "node scripts/secret-scan.js",
    "audit:deps": "npm audit --omit=dev",
    "verify": "npm run scan:secrets && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@elastic/elasticsearch": "^8.14.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mongodb": "^7.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.19.0",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/",
      "/tests/dbaas/_",
      "/tests/integration/_"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "collectCoverageFrom": [
      "dbaas/**/*.js",
      "adapters/**/*.js",
      "sdk/index.js",
      "query-cache.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 65,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
