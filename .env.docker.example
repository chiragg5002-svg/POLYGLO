# ============================================================
# MAESTRO / POLYGLODB — Docker Compose secrets/config template
# ============================================================
# This is a SEPARATE file from `.env` (which `npm start` reads via
# dotenv for the native workflow, using PG_HOST=localhost etc.).
# `.env` and this file are never merged: Compose only reads THIS one
# — and only for variable substitution inside docker-compose.yml /
# docker-compose.prod.yml — when you pass --env-file explicitly.
#
# Plain local dev:
#   docker compose up -d
#   (no .env.docker needed at all — docker-compose.yml's own
#   defaults, e.g. postgres/postgres, are fine for a throwaway local
#   database nobody else can reach)
#
# Anything beyond that — a shared dev box, staging, production:
#   cp .env.docker.example .env.docker
#   # edit .env.docker, put real, unique passwords in every field
#   docker compose --env-file .env.docker \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# NEVER commit a filled-in `.env.docker` — it's already covered by
# the `.env*` rule in .dockerignore, and should also be added to
# .gitignore if this project is under version control.

# ---- Server ----
NODE_ENV=production
PORT=3000

# ---- PostgreSQL ----
POSTGRES_USER=maestro
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=maestro

# ---- MongoDB ----
# Only read by docker-compose.prod.yml (the base file runs Mongo
# without auth, matching its previous local-dev-only behavior).
MONGO_ROOT_USERNAME=maestro
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-value

# ---- Elasticsearch ----
# Only read by docker-compose.prod.yml (the base file runs with
# xpack.security.enabled=false for local dev).
ELASTIC_PASSWORD=change-me-to-a-long-random-value

# ---- Redis ----
# Only read by docker-compose.prod.yml (the base file runs Redis
# without a password for local dev).
REDIS_PASSWORD=change-me-to-a-long-random-value

# ---- Query cache ----
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=60

# ---- Optional: Gemini-backed routes ----
GEMINI_API_KEY=

# ---- Optional: local Ollama on the host ----
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000

# ---- Cross-database query federation ----
FEDERATION_MAX_SOURCE_ROWS=2000
FEDERATION_DEFAULT_RESULT_ROWS=200
FEDERATION_MAX_RESULT_ROWS=1000
FEDERATION_TIMEOUT_MS=10000

# ---- DBaaS platform (see DBaaS.md) ----
# REQUIRED for docker-compose.prod.yml. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAESTRO_ADMIN_TOKEN=
# Optional: HMAC pepper for API-key hashes (set once, before issuing keys).
MAESTRO_KEY_PEPPER=
MAESTRO_RATE_LIMIT_PER_MINUTE=600
# Required for client email OTP login in production; keep stable across replicas.
MAESTRO_OTP_PEPPER=
MAESTRO_OTP_ACCOUNT_RATE_LIMIT_PER_MINUTE=5
# SMTP delivery for client email verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAESTRO_ROUTING_USE_OLLAMA=true
