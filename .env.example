# ============================================================
# MAESTRO / POLYGLODB — environment configuration template
# ============================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Every default below matches docker-compose.yml, so `docker compose
# up -d` + the defaults here work together out of the box. Nothing
# in this project calls a cloud API — every service is local.
# See ENVIRONMENT.md for the full reference (what each variable does,
# valid ranges, and which module reads it).

# ---- Server ----
PORT=3000
# development | production — production suppresses raw error detail
# in HTTP error responses (see server.js's sendError()).
NODE_ENV=development

# ---- PostgreSQL ----
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=postgres

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://localhost:9200

# ---- Redis (query result cache) ----
REDIS_URL=redis://localhost:6379
# Set to "false" to disable caching entirely, even with REDIS_URL set.
QUERY_CACHE_ENABLED=true
# How long a cached /v1/query result stays valid, in seconds.
QUERY_CACHE_TTL_SECONDS=60

# ---- Local Ollama (LLM-assisted routing — no cloud API involved) ----
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000

# ---- Cross-database query federation (prototype, /v1/query/federated) ----
# Hard per-source row cap for each side of a join (prevents
# uncontrolled full-database scans); absolute ceiling is 10000
# regardless of this value.
FEDERATION_MAX_SOURCE_ROWS=2000
# Default final joined-result row limit when the client doesn't
# specify one; absolute ceiling is 5000.
FEDERATION_DEFAULT_RESULT_ROWS=200
# Maximum final joined-result row limit a client can request;
# absolute ceiling is 5000.
FEDERATION_MAX_RESULT_ROWS=1000
# Overall wall-clock budget (ms) for fetching both sources of a
# federated query; clamped to 1000-60000 regardless of this value.
FEDERATION_TIMEOUT_MS=10000

# ---- DBaaS platform (projects, API keys, /v1/data ...) — see DBaaS.md ----
# Protects the control plane (/v1/projects*). REQUIRED when NODE_ENV=production
# (the control plane is disabled without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAESTRO_ADMIN_TOKEN=
# Optional extra secret mixed into API-key hashes (HMAC). Changing it later
# invalidates every existing key, so set it once, before issuing keys.
MAESTRO_KEY_PEPPER=
# Name of the PostgreSQL database that holds projects/keys/mappings/usage.
MAESTRO_CONTROL_DB=maestro_control
# Requests per API key per minute / failed-auth attempts per IP per minute.
MAESTRO_RATE_LIMIT_PER_MINUTE=600
MAESTRO_AUTH_FAIL_LIMIT_PER_MINUTE=30
# Client login OTP HMAC key (production: random secret, at least 32 bytes).
MAESTRO_OTP_PEPPER=
# OTP/account login starts per minute. Also applies to challenge resends.
MAESTRO_OTP_ACCOUNT_RATE_LIMIT_PER_MINUTE=5
# SMTP (local development can use a local SMTP test server such as Mailpit).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Create a collection automatically on the first POST /v1/data (default true).
MAESTRO_AUTO_CREATE_COLLECTIONS=true
# Limits.
MAESTRO_MAX_COLLECTIONS_PER_PROJECT=50
MAESTRO_MAX_DOCUMENT_BYTES=262144
MAESTRO_MAX_QUERY_LIMIT=1000
MAESTRO_DEFAULT_QUERY_LIMIT=50
# Intelligent routing for new collections: use local Ollama (true) or rule-based only (false).
MAESTRO_ROUTING_USE_OLLAMA=true
MAESTRO_ROUTING_TIMEOUT_MS=8000
# Below this hybrid confidence (0-100) the router falls back to PostgreSQL.
MAESTRO_ROUTING_MIN_CONFIDENCE=30
